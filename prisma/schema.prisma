generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(cuid())
  telegramId     String          @unique
  name           String
  username       String?
  avatar         String?
  createdAt      DateTime        @default(now())
  storageConfig  StorageConfig?
  files          File[]
  folders        Folder[]
  oauthAccounts  OAuthAccount[]
}

/// A third-party sign-in (Google, …) linked to a TeleDrive user. Storage always
/// resolves through the linked Telegram identity — this only carries the login.
model OAuthAccount {
  id         String   @id @default(cuid())
  userId     String
  provider   String
  providerId String
  email      String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

model StorageConfig {
  id              String   @id @default(cuid())
  userId          String   @unique
  botToken        String?
  botChannelId    String?
  telegramSession String?
  /// Per-user MTProto session (encrypted) authorised via QR / phone code.
  /// Unlocks single files up to 2 GB (4 GB with Telegram Premium).
  mtprotoSession  String?
  mtprotoUserId   String?
  mtprotoPremium  Boolean  @default(false)
  /// Half-finished MTProto login: the connected session + phone_code_hash that
  /// step 2 (sign-in) needs. Cleared once authorisation completes.
  pendingSession  String?
  pendingHash     String?
  pendingPhone    String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model File {
  id                String      @id @default(cuid())
  userId            String
  filename          String
  originalName      String
  mimeType          String
  size              BigInt
  storageMode       StorageMode
  telegramFileId    String?
  telegramMessageId String?
  telegramFilePath  String?
  storageChatId     String?
  thumbFileId       String?
  folderId          String?
  isDeleted         Boolean     @default(false)
  isFavorite        Boolean     @default(false)
  isChunked         Boolean     @default(false)
  totalChunks       Int         @default(0)
  uploadStatus      String      @default("complete")
  /// Which Telegram transport holds the bytes: "bot" (chunked, zero setup) or
  /// "mtproto" (the user's own session — one message, up to 2 GB / 4 GB Premium).
  backend           String      @default("bot")
  /// Stable client-supplied fingerprint (name+size+folder) so an interrupted
  /// upload can be found and resumed instead of restarted.
  resumeKey         String?
  createdAt         DateTime    @default(now())
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder            Folder?     @relation(fields: [folderId], references: [id], onDelete: SetNull)
  shares            Share[]
  chunks            Chunk[]

  @@index([userId, folderId])
  @@index([userId, createdAt])
  @@index([userId, resumeKey])
}

model Chunk {
  id             String  @id @default(cuid())
  fileId         String
  chunkIndex     Int
  telegramMsgId  Int
  telegramFileId String?
  chunkSize      Int
  file           File    @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, chunkIndex])
  @@index([fileId])
}

model Folder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    Folder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[] @relation("FolderTree")
  files     File[]
  shares    Share[]

  @@index([userId, parentId])
}

model Share {
  id           String    @id @default(cuid())
  fileId       String?
  folderId     String?
  shareToken   String    @unique
  expiryDate   DateTime?
  passwordHash String?
  disabled     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  file         File?     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  folder       Folder?   @relation(fields: [folderId], references: [id], onDelete: Cascade)
}

model BotLoginCode {
  id         String   @id @default(cuid())
  telegramId String
  name       String
  username   String?
  avatar     String?
  code       String
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([code])
}

enum StorageMode {
  BOT
  PERSONAL
}
