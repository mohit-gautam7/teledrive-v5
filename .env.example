# ── Required ─────────────────────────────────────────────────────────────────
# Telegram bot token from @BotFather — this bot stores files in each user's chat
BOT_TOKEN=
# Postgres connection string (Supabase free tier works).
# On serverless use the transaction pooler: :6543 with ?pgbouncer=true&connection_limit=1
DATABASE_URL=
# Long random string for signing login cookies (24+ chars)
JWT_SECRET=
# Long random string protecting the Telegram webhook + /api/bot/setup
WEBHOOK_SECRET=
# Public URL of the deployed site, e.g. https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=
# Bot username without @ — shown on the login page
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# ── Large files (2 GB+ through the user's own Telegram account) ──────────────
# From https://my.telegram.org. Without these, only bot storage is available.
API_ID=
API_HASH=
# Encrypts stored Telegram sessions at rest — set this if you enable linking.
SESSION_ENCRYPTION_KEY=

# ── Optional sign-in providers ───────────────────────────────────────────────
# Google OAuth. Redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Owner-key login (bypasses Telegram; useful for administration)
OWNER_LOGIN_KEY=
OWNER_TELEGRAM_ID=

# ── Always-on deployment (docker-compose) ────────────────────────────────────
# Domain Caddy should obtain a TLS certificate for
APP_DOMAIN=

# ── Legacy only (recovering files from older TeleDrive versions) ─────────────
BOT_CHANNEL_ID=
TELEGRAM_SESSION=

# ── AI platform (Phase 2) ────────────────────────────────────────────────────
# Off unless set to 1. Users bring their own provider keys; nothing here is a
# provider key. Requires SESSION_ENCRYPTION_KEY, which encrypts them at rest.
AI_ENABLED=
# Drain the background job queue in this process. Only ever set this on the
# always-on host — a serverless function is killed before a job can finish.
JOB_WORKER_ENABLED=
# Optional token prices, so usage can be costed. Keyed "provider:model", in
# micro-USD per million tokens (3000000 = $3.00/Mtok). Models absent from this
# map report a null cost rather than a guessed one.
# AI_PRICING_JSON={"openai:gpt-x":{"in":2500000,"out":10000000}}
AI_PRICING_JSON=

# ── Throughput (always-on hosts only) ────────────────────────────────────────
# Bytes per upload chunk, in MB. Default 4, which is the only value that fits
# Vercel's 4.5 MB request-body cap. On Render or a VM, 16–32 cuts round-trips
# (and Telegram messages) by the same factor. Capped at 50; rounded down to a
# whole number of 512 KiB MTProto parts.
UPLOAD_CHUNK_MB=
# Chunks in flight per file, per browser. Default 3.
UPLOAD_CONCURRENCY=
# In-flight Telegram sendDocument calls for the whole process. Default 4; the
# bot's budget is ~30 messages/second shared by everyone.
TELEGRAM_MAX_INFLIGHT=
# ...and per user, so one fast uploader cannot take every slot.
# Defaults to half of TELEGRAM_MAX_INFLIGHT.
TELEGRAM_MAX_INFLIGHT_PER_USER=

# Temporary diagnostics for Telegram account linking. Prints which branch of the
# QR handshake fires (export / migrate / success / password) and whether the
# session was persisted. Never prints session strings or tokens. Unset to silence.
DEBUG_TG_LINK=

# ── Split hosting: app on Vercel, file bytes on Render ───────────────────────
# Both deployments run the same code against the same DATABASE_URL and the same
# JWT_SECRET. Only the traffic is divided: Vercel serves the app and its light
# JSON routes, and the browser calls the Render URL directly for uploads,
# downloads, previews and video streams. Nothing is proxied — a proxied byte
# still crosses Vercel and still counts against its 100 GB.
#
# Set BOTH or NEITHER. Neither = one origin, exactly as before (and what you
# want for `pnpm dev`).
#
# On the Vercel deployment — the Render service's URL, no trailing slash.
# This is inlined into the browser bundle at BUILD time, so changing it needs a
# redeploy, not just a restart.
# NEXT_PUBLIC_FILE_ORIGIN=https://teledrive.onrender.com
NEXT_PUBLIC_FILE_ORIGIN=
# On the Render deployment — the origins allowed to call it, comma-separated,
# exact, no trailing slash. Read at runtime by middleware.ts.
# CORS_ALLOWED_ORIGINS=https://teledrive-codex1.vercel.app
CORS_ALLOWED_ORIGINS=
