# Automatic HTTPS via Let's Encrypt. Point APP_DOMAIN's A record at the VM first.
{$APP_DOMAIN} {
	encode zstd gzip

	reverse_proxy app:3000 {
		# Large uploads and long downloads must not be cut off mid-transfer.
		flush_interval -1
	}

	# Must stay comfortably above UPLOAD_CHUNK_MB, which is 4 only because
	# Vercel forced it — on this host it should be 16-32. The ceiling is bounded
	# so a malformed request cannot exhaust memory; raise both together or a
	# chunk will be rejected here before the app ever sees it.
	request_body {
		max_size 64MB
	}

	# Cross-origin preflights must reach the app: when this host is the file
	# origin for a Vercel-served front end, middleware.ts answers OPTIONS and
	# sets the CORS headers. Caddy passes both through untouched — nothing to
	# configure here, but do not add a header directive that strips them.

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
