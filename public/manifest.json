{
  "id": "/drive",
  "name": "TeleDrive Personal",
  "short_name": "TeleDrive",
  "description": "A private cloud drive powered by Telegram storage.",
  "start_url": "/drive",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#0f172a",
  "theme_color": "#0f172a",
  "orientation": "any",
  "categories": ["productivity", "utilities"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["image/*", "video/*", "audio/*", "text/*", "application/pdf", "application/zip", "application/octet-stream"]
        }
      ]
    }
  },
  "shortcuts": [
    { "name": "Upload", "short_name": "Upload", "url": "/drive?upload=1", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Recent", "short_name": "Recent", "url": "/drive?view=recent", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
