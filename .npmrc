# Prisma needs its postinstall to fetch the query engine; pnpm 10 blocks build
# scripts by default and a missing engine shows up as "no exported member" type
# errors across every route that touches the database.
onlyBuiltDependencies[]=@prisma/client
onlyBuiltDependencies[]=@prisma/engines
onlyBuiltDependencies[]=prisma
onlyBuiltDependencies[]=sharp
